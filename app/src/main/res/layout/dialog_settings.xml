<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A2E">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textColor="#E94560"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- Sélecteur de langue -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_language_label"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <Button
                android:id="@+id/btn_lang_fr"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="@string/dialog_lang_fr"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:backgroundTint="#E94560"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btn_lang_en"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="@string/dialog_lang_en"
                android:textColor="#AAAAAA"
                android:textSize="12sp"
                android:backgroundTint="#333355" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#333355"
            android:layout_marginBottom="16dp" />

        <!-- Vitesse seuil -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_speed_label"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_speed_val"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#00FF88"
                android:textSize="14sp"
                android:fontFamily="monospace"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_speed_desc"
            android:textColor="#888888"
            android:textSize="11sp"
            android:layout_marginTop="2dp" />

        <SeekBar
            android:id="@+id/sb_speed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:max="40" />

        <!-- Durée d'armement -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_time_label"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_time_val"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#00FF88"
                android:textSize="14sp"
                android:fontFamily="monospace"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_time_desc"
            android:textColor="#888888"
            android:textSize="11sp"
            android:layout_marginTop="2dp" />

        <SeekBar
            android:id="@+id/sb_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:max="15" />

        <!-- Délai avant fermeture -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_delay_label"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_delay_val"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#00FF88"
                android:textSize="14sp"
                android:fontFamily="monospace"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_delay_desc"
            android:textColor="#888888"
            android:textSize="11sp"
            android:layout_marginTop="2dp" />

        <SeekBar
            android:id="@+id/sb_delay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:max="30" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#333355"
            android:layout_marginBottom="16dp" />

        <!-- ──────── Configuration par vitre ──────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/windows_title"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/windows_desc"
            android:textColor="#888888"
            android:textSize="11sp"
            android:layout_marginBottom="12dp" />

        <!-- Disposition 2×2 type vue de dessus : voiture centrée, vitres aux 4 coins -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp">

            <!-- Silhouette voiture centrale -->
            <ImageView
                android:id="@+id/iv_car"
                android:layout_width="80dp"
                android:layout_height="120dp"
                android:layout_centerInParent="true"
                android:src="@drawable/ic_car_top"
                android:contentDescription="@null" />

            <!-- AV-G : haut gauche -->
            <LinearLayout
                android:id="@+id/panel_fl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/win_fl"
                    android:textColor="#E0E0E0"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="3dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <Button
                        android:id="@+id/btn_fl_auto"
                        android:layout_width="46dp"
                        android:layout_height="32dp"
                        android:text="@string/mode_auto"
                        android:textSize="9sp"
                        android:padding="0dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:layout_marginEnd="2dp" />
                    <Button
                        android:id="@+id/btn_fl_pulsed"
                        android:layout_width="46dp"
                        android:layout_height="32dp"
                        android:text="@string/mode_pulsed"
                        android:textSize="9sp"
                        android:padding="0dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:layout_marginEnd="2dp" />
                    <Button
                        android:id="@+id/btn_fl_off"
                        android:layout_width="46dp"
                        android:layout_height="32dp"
                        android:text="@string/mode_off"
                        android:textSize="9sp"
                        android:padding="0dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- AV-D : haut droit -->
            <LinearLayout
                android:id="@+id/panel_fr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignParentTop="true"
                android:orientation="vertical"
                android:gravity="end">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/win_fr"
                    android:textColor="#E0E0E0"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="3dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <Button
                        android:id="@+id/btn_fr_auto"
                        android:layout_width="46dp"
                        android:layout_height="32dp"
                        android:text="@string/mode_auto"
                        android:textSize="9sp"
                        android:padding="0dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:layout_marginEnd="2dp" />
                    <Button
                        android:id="@+id/btn_fr_pulsed"
                        android:layout_width="46dp"
                        android:layout_height="32dp"
                        android:text="@string/mode_pulsed"
                        android:textSize="9sp"
                        android:padding="0dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:layout_marginEnd="2dp" />
                    <Button
                        android:id="@+id/btn_fr_off"
                        android:layout_width="46dp"
                        android:layout_height="32dp"
                        android:text="@string/mode_off"
                        android:textSize="9sp"
                        android:padding="0dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- AR-G : bas gauche -->
            <LinearLayout
                android:id="@+id/panel_rl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_alignParentBottom="true"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="3dp">
                    <Button
                        android:id="@+id/btn_rl_auto"
                        android:layout_width="46dp"
                        android:layout_height="32dp"
                        android:text="@string/mode_auto"
                        android:textSize="9sp"
                        android:padding="0dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:layout_marginEnd="2dp" />
                    <Button
                        android:id="@+id/btn_rl_pulsed"
                        android:layout_width="46dp"
                        android:layout_height="32dp"
                        android:text="@string/mode_pulsed"
                        android:textSize="9sp"
                        android:padding="0dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:layout_marginEnd="2dp" />
                    <Button
                        android:id="@+id/btn_rl_off"
                        android:layout_width="46dp"
                        android:layout_height="32dp"
                        android:text="@string/mode_off"
                        android:textSize="9sp"
                        android:padding="0dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/win_rl"
                    android:textColor="#E0E0E0"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- AR-D : bas droit -->
            <LinearLayout
                android:id="@+id/panel_rr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignParentBottom="true"
                android:orientation="vertical"
                android:gravity="end">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="3dp">
                    <Button
                        android:id="@+id/btn_rr_auto"
                        android:layout_width="46dp"
                        android:layout_height="32dp"
                        android:text="@string/mode_auto"
                        android:textSize="9sp"
                        android:padding="0dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:layout_marginEnd="2dp" />
                    <Button
                        android:id="@+id/btn_rr_pulsed"
                        android:layout_width="46dp"
                        android:layout_height="32dp"
                        android:text="@string/mode_pulsed"
                        android:textSize="9sp"
                        android:padding="0dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:layout_marginEnd="2dp" />
                    <Button
                        android:id="@+id/btn_rr_off"
                        android:layout_width="46dp"
                        android:layout_height="32dp"
                        android:text="@string/mode_off"
                        android:textSize="9sp"
                        android:padding="0dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/win_rr"
                    android:textColor="#E0E0E0"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_settings_reset"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="@string/settings_reset"
                android:textColor="#AAAAAA"
                android:textSize="12sp"
                android:backgroundTint="#333355"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btn_settings_close"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="@string/dialog_ok"
                android:textColor="#FFFFFF"
                android:backgroundTint="#E94560" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
